        "selector": "JSXOpeningElement[name.name='AvatarStackPerson'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|key|ref|className|style|children)$/]",
        "message": "<AvatarStackPerson> doesn't accept that prop. Declared props: name, hue."
