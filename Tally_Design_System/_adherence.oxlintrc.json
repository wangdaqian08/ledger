{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/lists/**",
              "components/navigation/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|size|tone|showSign|animate|style|key|ref|className|style|children)$/]",
        "message": "<Amount> doesn't accept that prop. Declared props: value, currency, size, tone, showSign, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|hero)$/]",
        "message": "<Amount> size must be one of 'sm' | 'md' | 'lg' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|owed|owe|settled|onDark)$/]",
        "message": "<Amount> tone must be one of 'neutral' | 'owed' | 'owe' | 'settled' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|label|tone|style|key|ref|className|style|children)$/]",
        "message": "<AmountInput> doesn't accept that prop. Declared props: value, currency, label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountInput'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|owe|owed)$/]",
        "message": "<AmountInput> tone must be one of 'neutral' | 'owe' | 'owed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onBack|actions|tone|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, subtitle, onBack, actions, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink)$/]",
        "message": "<AppBar> tone must be one of 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|size|selected|dimmed|compact|badge|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, hue, size, selected, dimmed, compact, badge, style."
      },
